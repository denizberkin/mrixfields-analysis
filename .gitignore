# Report sources. The .tex, the figures they include and the tables they \input are
# tracked so reports/ builds from a clean clone; compiled PDFs, speaker notes and
# LaTeX build junk stay out. Must sit after the global *.png rule above to win.
/reports/*
!/reports/*.tex
!/reports/figures/
!/reports/spectral/
!/reports/tables/
!/reports/visuals/
!/reports/**/*.png

