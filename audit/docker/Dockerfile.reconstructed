FROM <ubuntu-24.04 + python3.12 + torch 2.13.0+cu126 base>   # e.g. pytorch/pytorch:2.13.0-cuda12.6-cudnn9-runtime

WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /app/requirements.txt
COPY inference.py /app/inference.py
COPY mrx /app/mrx
COPY weights /app/weights
RUN chmod a+x /app/inference.py
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TORCH_HOME=/app/.torch
RUN python3 -c "import sys, torch; sys.path.insert(0, '/app'); print('interpreter', sys.executable) ..."   # build-time import self-check
ENTRYPOINT ["python3", "/app/inference.py"]
CMD ["--input", "/input", "--output", "/output"]
